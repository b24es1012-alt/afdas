# ─── AFDAS Backend Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Application ─────────────────────────────────────────────────────────────
AFDAS_ENV=development
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ─── PostgreSQL / PostGIS ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afdas
DB_USER=afdas_user
DB_PASSWORD=afdas_password
DB_POOL_MIN=5
DB_POOL_MAX=20

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_GRAPH_TTL=86400
REDIS_WEIGHT_TTL=3600
REDIS_ROUTE_TTL=1800

# ─── Copernicus EMS ──────────────────────────────────────────────────────────
COPERNICUS_API_URL=https://emergency.copernicus.eu/mapping/list-of-components
COPERNICUS_POLL_INTERVAL=300

# ─── OpenStreetMap ───────────────────────────────────────────────────────────
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=AFDAS-FloodNavigation/1.0
OSM_RATE_LIMIT=1.0

# ─── AI / Groq LLM ──────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ─── Data Directories ────────────────────────────────────────────────────────
DATA_DIR=./data
FLOOD_DATA_DIR=./data/flood
OSM_DATA_DIR=./data/osm
GRAPH_DATA_DIR=./data/graphs
